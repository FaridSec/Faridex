<!-- LIBRARIES: Lenis (Smooth Scroll) & GSAP (Animations) -->
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.2/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.2/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.0.28/dist/lenis.min.js"></script>

<script>
  // 1. Initialize Lenis for buttery smooth scrolling (just like the 8B templates)
  const lenis = new Lenis({ lerp: 0.08 });
  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);

  // 2. Initialize GSAP ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);
  
  // Connect Lenis to GSAP
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time)=>{ lenis.raf(time * 1000) });
  gsap.ticker.lagSmoothing(0);

  // 3. The "Rise" Animation Engine (Replicating 8B's data-motion approach)
  const riseElements = document.querySelectorAll('[data-motion="rise"]');
  riseElements.forEach((el) => {
    gsap.to(el, {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: el,
        start: "top 85%", // Triggers when element is 85% down the viewport
        once: true
      }
    });
  });

  // 4. Contact Form Secure Routing Logic (Your existing Cloudflare Worker)
  const WORKER_URL = "https://faridex-notify.devsecop3.workers.dev";
  const form = document.getElementById('cv-form');
  const msg = document.getElementById('form-message');
  const btn = document.getElementById('submit-btn');

  form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email-input').value;
      
      btn.disabled = true;
      btn.textContent = "Processing...";
      msg.textContent = "";

      try {
          const response = await fetch(WORKER_URL, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email: email })
          });

          if (response.ok) {
              msg.textContent = "Request received. CV dispatched.";
              form.reset();
          } else {
              throw new Error("Failed");
          }
      } catch (error) {
          msg.textContent = "Routing failed. Please email contact@faridsec.com directly.";
          msg.style.color = "#FF7A6B";
      } finally {
          btn.disabled = false;
          btn.textContent = "Send Credentials via Email";
      }
  });
</script>

